# Text files are stored with LF; Windows batch files keep CRLF, which cmd.exe needs.
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# Unity writes its YAML (scenes, assets, settings, meta files) with LF; keep LF in the working
# copy too, so saving in Unity doesn't make every file look changed on Windows
*.unity text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.uss text
*.shader text

# binaries
*.dll binary
*.exe binary
*.png binary
*.jpg binary
